---
import '@ulab/ui/index.css';
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>U.LAB</title>
	</head>
	<body>
		<main class="home">
			<span class="home__logo">U.LAB</span>
			<p class="home__tagline">
				L'atelier de création visuelle gratuit, sans compte et sans paywall.
			</p>
			<a class="home__cta" href="/create">Ouvrir l'éditeur</a>
		</main>
	</body>
</html>

<style>
	body {
		background: var(--bg-0);
		color: var(--ink);
		font-family: var(--font-sans);
	}

	.home {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--space-16);
		min-height: 100vh;
		padding: var(--space-24);
		text-align: center;
	}

	.home__logo {
		font-size: var(--t-h1);
		font-weight: 500;
		color: var(--ink);
	}

	.home__tagline {
		max-width: var(--measure);
		font-size: var(--t-base);
		color: var(--ink-muted);
	}

	.home__cta {
		display: inline-flex;
		align-items: center;
		height: var(--button-height);
		padding: var(--button-padding);
		margin-top: var(--space-8);
		border-radius: var(--r);
		background: var(--accent);
		color: var(--accent-ink);
		font-family: var(--font-sans);
		font-size: var(--t-base);
		font-weight: 500;
		text-decoration: none;
	}

	.home__cta:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: var(--focus-offset);
	}
</style>
